# ── PostgreSQL ─────────────────────────────────────────
POSTGRES_USER=my_pets_user
POSTGRES_PASSWORD=change-this-password-in-production
POSTGRES_DB=my_pets

# DATABASE_URL debe coincidir con las credenciales de arriba
DATABASE_URL=host=db user=my_pets_user password=change-this-password-in-production dbname=my_pets port=5432 sslmode=disable

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-in-production

# ── API ──────────────────────────────────────────────
PORT=8080
GIN_MODE=release
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# ── Google OAuth (opcional) ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
