# Copy this file to .env and fill in real values.
# Never commit .env to source control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
GIN_MODE=debug            # set to "release" in production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=host=localhost user=devuser password=devpassword dbname=my_pets port=5432 sslmode=disable

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret

# ── URLs ──────────────────────────────────────────────────────────────────────
# APP_URL is the public base URL of the API (used for Google OAuth redirect URI)
APP_URL=http://localhost:8080
# FRONTEND_URL is where the browser is redirected after OAuth completes
FRONTEND_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: ${APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
